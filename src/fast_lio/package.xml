<?xml version="1.0"?>
<package format="3">
  <name>fast_lio</name>
  <version>0.0.0</version>
  <description>
    FAST-LIO2 (hku-mars, branch ROS2) adapted for the Unitree G1 with a Livox Mid-360 on ROS 2 Foxy.
  </description>
  <maintainer email="vor.roman.v@gmail.com">Roman Voronov</maintainer>
  <license>GPL-2.0</license>
  <author>Wei Xu, Yixi Cai, Dongjiao He, Fangcheng Zhu, Jiarong Lin, Zheng Liu (HKU MARS)</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>livox_ros_driver2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

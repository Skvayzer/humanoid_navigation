# Copy to config/site.env (gitignored). These defaults target a Unitree G1.
# Paths belong to the account doing the deployment; no /home/unitree assumption.
# export G1_SLAM_RUNTIME_DIR="$HOME/g1_slam_runtime"
# export G1_CYCLONE_WS="$HOME/cyclonedds_ws"
# export G1_LIVOX_WS="$HOME/livox_ws"
# export G1_HOST_CYCLONEDDS_URI="$G1_CYCLONE_WS/cyclonedds.xml"
# export G1_SDK_INTERFACE=eth0
# export G1_MOTION_PYTHON="$HOME/.venvs/g1-motion/bin/python3"
# export ROS_DOMAIN_ID=0
# export G1_NAV_MAP_YAML=/data/maps/teaching_lab_nav/teaching_lab_nav.yaml
# export G1_SLAM_DEFAULT_MAP=teaching_lab_aligned.pcd
# Also review config/cyclonedds.xml, LiDAR extrinsics, NDT initial pose and Nav2
# footprint before using a different robot or map. Do not raise motion limits
# as part of installation.
